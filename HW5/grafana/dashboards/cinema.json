{
  "title": "Online Cinema",
  "uid": "online-cinema",
  "schemaVersion": 41,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-14d/d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Daily active users",
      "description": "Unique users with any event in the UTC day.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cinema-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cinema-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(day, 'UTC') AS time, value AS value\nFROM cinema.daily_metrics\nWHERE $__dateFilter(day) AND metric = 'dau'\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "View conversion",
      "description": "Finished views divided by starts in the same UTC day.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cinema-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cinema-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(day, 'UTC') AS time, value AS value\nFROM cinema.daily_metrics\nWHERE $__dateFilter(day) AND metric = 'conversion'\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Average watch time",
      "description": "Average progress of finished views, in minutes.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cinema-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cinema-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(day, 'UTC') AS time, value / 60 AS value\nFROM cinema.daily_metrics\nWHERE $__dateFilter(day) AND metric = 'avg_watch_seconds'\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#B877D9"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "Retention Cohort Heatmap",
      "description": "Cohorts are grouped by first viewing day (UTC). A cell shows the share with viewing activity at that exact age. Future dates are blank.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 13
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cinema-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cinema-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT\n    toString(day) AS Cohort,\n    toUInt64(maxIf(value, metric = 'cohort_size')) AS Users,\n    maxIf(value, metric = 'retention_d0') AS `Day 0`,\n    maxIf(value, metric = 'retention_d1') AS `Day 1`,\n    maxIf(value, metric = 'retention_d2') AS `Day 2`,\n    maxIf(value, metric = 'retention_d3') AS `Day 3`,\n    maxIf(value, metric = 'retention_d4') AS `Day 4`,\n    maxIf(value, metric = 'retention_d5') AS `Day 5`,\n    maxIf(value, metric = 'retention_d6') AS `Day 6`,\n    maxIf(value, metric = 'retention_d7') AS `Day 7`\nFROM cinema.daily_metrics\nWHERE $__dateFilter(day) AND (startsWith(metric, 'retention_d') OR metric = 'cohort_size')\nGROUP BY day\nHAVING Users > 0\nORDER BY day DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "noValue": "—",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#282D45"
              },
              {
                "value": 0.15,
                "color": "#414978"
              },
              {
                "value": 0.3,
                "color": "#505CB9"
              },
              {
                "value": 0.45,
                "color": "#4276C8"
              },
              {
                "value": 0.65,
                "color": "#277C94"
              },
              {
                "value": 0.85,
                "color": "#136863"
              }
            ]
          },
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            },
            "minWidth": 64
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cohort"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Users"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "custom.width",
                "value": 92
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "title": "Top movies",
      "description": "The 10 most watched titles by number of starts in the selected range.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cinema-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cinema-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT dimension AS Movie, toUInt64(sum(value)) AS Views\nFROM cinema.daily_metrics\nWHERE $__dateFilter(day) AND metric = 'movie_views'\nGROUP BY dimension\nORDER BY Views DESC, Movie\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Views"
            },
            "properties": [
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "color"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
